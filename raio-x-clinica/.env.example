# Copie pra .env (gitignored) e exporte antes de subir o servidor:
#   set -a; source .env; set +a; npm start

# Chave da API da Anthropic. Sem ela, POST /api/laudo responde 503 sem_chave
# (o resto da API — avaliar, lead, salvar — funciona sem chave).
# ANTHROPIC_API_KEY=sk-ant-...

# Modelo que escreve o laudo comentado. Default: claude-sonnet-5.
# LAUDO_MODEL=claude-sonnet-5

# Pra onde POST /api/lead repassa cada lead (JSON: id, criado_em, lead, resumo).
# Zapier / Make / Apps Script da planilha. Vazio = desligado. Timeout 5s; falha não derruba a resposta.
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# Pasta onde ficam leads.jsonl e laudos/<id>.json. Default: ./data (gitignored).
# RAIOX_DATA_DIR=/var/lib/raio-x

# Porta do server.mjs. Default: 8787.
# PORT=8787
